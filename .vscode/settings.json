{
    "makefile.makefilePath": "./qserver",
    "makefile.compileCommandsPath": "./qserver",
    "files.associations": {
        "*.pch": "cpp",
        "vector": "cpp"
    },
    "editor.formatOnSave": true,
    "C_Cpp.formatting": "vcFormat",
    "files.exclude": {
        "**/.git": true,
        "**/.gitignore": true,
        "**/.DS_Store": true,
        "**/DerivedData": true,
        "**/*.o": true,
        "**/*.dSYM": true,
        "**/sandbox": true,
    },
    "search.exclude": {
        "**/*.o": true
    }
}