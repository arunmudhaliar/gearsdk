{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format Server code",
            "type": "shell",
            "command": "find ${workspaceFolder}/qh3server ${workspaceFolder}/qserver -type f \\( -iname '*.cpp' -o -iname '*.h' -o -iname '*.hpp' -o -iname '*.c' \\) | xargs clang-format -i"
        },
        {
            "label": "Format Client code",
            "type": "shell",
            "command": "find ${workspaceFolder}/qh3client ${workspaceFolder}/qclient -type f \\( -iname '*.cpp' -o -iname '*.h' -o -iname '*.hpp' -o -iname '*.c' \\) | xargs clang-format -i"
        },
        {
            "label": "Format library code",
            "type": "shell",
            "command": "find ${workspaceFolder}/qutils ${workspaceFolder}/networkcommon/source ${workspaceFolder}/servercommon/source ${workspaceFolder}/qhiredis/source ${workspaceFolder}/qstats-crawler/qstats-crawler ${workspaceFolder}/qzookeeper/source -type d \\( -path '*/ev' -o -path '*/quiche' -o -path '*/libmongoc-1.0' -o -path '*/libmongoc-1.0' -o -path '*/libs' -o -path '*/dpp' \\) -prune -o -type f \\( -iname '*.cpp' -o -iname '*.h' -o -iname '*.hpp' -o -iname '*.c' \\) -print | xargs clang-format -i"
        },
        {
            "label": "(QFIST) Build Debug with Clang",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "qfist",
                "debug",
                "DDEV_BUILD=1",
                "LOG_LEVEL=1"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "env": {
                    "CXX": "clang++",
                    "CC": "clang"
                }
            },
            "detail": "Build the project in debug mode with Clang.",
            // "dependsOn": "(qh3sampleserver) Pre-Build Task"
        },
        {
            "label": "(QFIST) Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "qfist",
                "clean"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Clean the project."
        },
        {
            "label": "(QH3CLIENT) Build Debug with Clang",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "qh3client",
                "debug",
                "LOG_LEVEL=2"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "env": {
                    "CXX": "clang++",
                    "CC": "clang"
                }
            },
            "detail": "Build the project in debug mode with Clang.",
            // "dependsOn": "(QH3CLIENT) Pre-Build Task"
        },
        {
            "label": "(TEST-QH3CLIENT) Build Debug with Clang",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "qh3client",
                "test",
                "LOG_LEVEL=2"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "env": {
                    "CXX": "clang++",
                    "CC": "clang"
                }
            },
            "detail": "Build the project in test mode with Clang.",
            // "dependsOn": "(QH3CLIENT) Pre-Build Task"
        },
        {
            "label": "(QH3CLIENT) Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "qh3client",
                "clean"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Clean the project."
        },
        {
            "label": "(qh3sampleserver) Build Debug with Clang",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "qh3sampleserver",
                "debug",
                "FORK_QH3_SERVER=0",
                "LOG_LEVEL=2"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "env": {
                    "CXX": "clang++",
                    "CC": "clang"
                }
            },
            "detail": "Build the project in debug mode with Clang.",
            // "dependsOn": "(qh3sampleserver) Pre-Build Task"
        },
        {
            "label": "(qh3server) Build Debug with Clang",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "qh3server",
                "debug",
                "FORK_QH3_SERVER=0",
                "LOG_LEVEL=2"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "env": {
                    "CXX": "clang++",
                    "CC": "clang"
                }
            },
            "detail": "Build the project in debug mode with Clang.",
            // "dependsOn": "(qh3server) Pre-Build Task"
        },
        {
            "label": "(qh3sampleserver) Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "qh3sampleserver",
                "clean"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Clean the project."
        }
    ]
}