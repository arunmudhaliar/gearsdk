{
    "name": "serverplugin-ts",
    "version": "1.0.0",
    "description": "A project using ffi-napi and ref-napi with TypeScript.",
    "main": "dist/app.js",
    "scripts": {
        "build": "tsc",
        "build:debug": "tsc -p tsconfig.debug.json && cp ../serverplugin/libserverplugin-debug.node ./dist/",
        "build:release": "tsc -p tsconfig.json && cp ../serverplugin/libserverplugin.node ./dist/",
        "start": "NODE_ENV=development DYLD_LIBRARY_PATH='./dist' node dist/app.js",
        "start:release": "NODE_ENV=production DYLD_LIBRARY_PATH='./dist' node dist/app.js",
        "watch": "tsc --watch -p tsconfig.debug.json && cp ../serverplugin/libserverplugin-debug.node ./dist/"
    },
    "dependencies": {
        "class-transformer": "^0.5.1",
        "ioredis": "^5.4.2",
        "mongodb": "^6.12.0",
        "node-zookeeper-client": "^1.1.3"
    },
    "devDependencies": {
        "@types/node-zookeeper-client": "^0.2.14",
        "typescript": "^5.7.2"
    },
    "keywords": [],
    "author": "amudaliar",
    "license": "ISC"
}
