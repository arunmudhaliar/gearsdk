{
    "name": "serverplugin-ts",
    "version": "1.0.0",
    "description": "A project using ffi-napi and ref-napi with TypeScript.",
    "main": "dist/serverplugin.js",
    "scripts": {
        "build": "tsc",
        "build:debug": "tsc",
        "build:release": "tsc",
        "start": "NODE_ENV=development DYLD_LIBRARY_PATH='../serverplugin' node dist/app.js",
        "start:release": "NODE_ENV=production DYLD_LIBRARY_PATH='../serverplugin' node dist/app.js",
        "watch": "tsc --watch -p tsconfig.debug.json"
    },
    "dependencies": {
        "class-transformer": "^0.5.1",
        "ffi-napi": "^4.0.3",
        "ioredis": "^5.4.2",
        "mongodb": "^6.12.0",
        "node-zookeeper-client": "^1.1.3",
        "ref-napi": "^3.0.3",
        "ref-struct-napi": "^1.1.1"
    },
    "devDependencies": {
        "@types/ffi-napi": "^4.0.10",
        "@types/node-zookeeper-client": "^0.2.14",
        "@types/ref-napi": "^3.0.12",
        "typescript": "^5.7.2"
    },
    "keywords": [],
    "author": "amudaliar",
    "license": "ISC"
}
