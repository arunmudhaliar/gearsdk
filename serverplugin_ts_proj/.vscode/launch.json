{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug - Launch serverplugin SDK",
        "program": "${workspaceFolder}/dist/app.js",
        "env": {
          "DYLD_LIBRARY_PATH": "${workspaceFolder}/../serverplugin"
        },
        "outFiles": [
          "${workspaceFolder}/dist/**/*.js"
        ],
        "sourceMaps": true,
        "runtimeVersion": "16.16.0",
        "runtimeExecutable": "node",
        "preLaunchTask": "build:debug",
        "runtimeArgs": [
          "--trace-exit"
        ],
        "outputCapture": "std"
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Release - Launch serverplugin SDK",
        "program": "${workspaceFolder}/dist/app.js",
        "env": {
          "DYLD_LIBRARY_PATH": "${workspaceFolder}/../serverplugin"
        },
        "outFiles": [
          "${workspaceFolder}/dist/**/*.js"
        ],
        "sourceMaps": false,
        "runtimeVersion": "16.16.0",
        "runtimeExecutable": "node",
        "preLaunchTask": "build:release",
        "outputCapture": "std"
      },
      {
        "name": "Debug serverplugin C++ from Node.js",
        "type": "cppdbg",
        "request": "attach",
        "program": "~/.nvm/versions/node/v16.16.0/bin/node",
        "processId": "${command:pickProcess}",
        "targetArchitecture": "x86_64",
        "MIMode": "lldb", // Use "gdb" if you are on Linux and prefer GDB
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ],
        "sourceFileMap": {
          "/Users/amudaliar/Documents/PROJECTS/PERSONAL/gearsdk/serverplugin": "${workspaceFolder}/../serverplugin"
        }
      }    
    ]
  }
  