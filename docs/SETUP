# docker setup
    sudo apt update
    sudo apt install apt-transport-https ca-certificates curl software-properties-common
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo tee /etc/apt/trusted.gpg.d/docker.asc
    sudo add-apt-repository "deb [arch=amd64] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable"
    sudo apt update
    sudo apt install docker-ce
    sudo systemctl start docker
    sudo systemctl enable docker
    docker --version
    sudo systemctl status docker
    sudo usermod -aG docker $USER

# cpu-monitor
    # dependencies
    sudo apt install python3-pip
    pip3 install psutil --break-system-packages

# create the log file
sudo touch /var/log/cpu-monitor.log
sudo chmod 664 /var/log/cpu-monitor.log
sudo chown ubuntu:ubuntu /var/log/cpu-monitor.log

# log rotation
sudo vi /etc/logrotate.d/cpu-monitor
# --------
/var/log/cpu-monitor.log {
    daily               # Rotate logs every day
    missingok           # Don't throw an error if the log file is missing
    rotate 7            # Keep 7 rotated logs
    compress            # Compress old logs with gzip
    delaycompress       # Don't compress the most recent rotated log
    notifempty          # Don't rotate the log if it is empty
    create 0644 ubuntu ubuntu   # Create a new log file with specified permissions and ownership
    su ubuntu ubuntu    # Run as the 'ubuntu' user and group
    postrotate
        # Restart the cpu monitor service to create a new log file after rotation
        systemctl kill --signal=HUP cpu-monitor.service
    endscript
}
# --------

# cpu-monitor service
# /etc/systemd/system/cpu-monitor.service
# -------------------------------------------------------
[Unit]
Description=CPU Monitor Script
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/ubuntu/scripts/cpu-monitor.py --cpu-threshold 40 --check-interval 4 --sample-history 3
Restart=always
User=ubuntu
WorkingDirectory=/usr/local/bin
Environment="PYTHONUNBUFFERED=1"
StandardOutput=append:/var/log/cpu-monitor.log
StandardError=append:/var/log/cpu-monitor.log

[Install]
WantedBy=multi-user.target
# -------------------------------------------------------

    sudo systemctl daemon-reload
    sudo systemctl enable cpu-monitor.service
    sudo systemctl start cpu-monitor.service
    sudo systemctl status cpu-monitor.service

