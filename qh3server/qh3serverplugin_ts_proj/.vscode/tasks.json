{
	"version": "2.0.0",
	"tasks": [
	  {
		"label": "tsc: watch",
		"type": "shell",
		"command": "source ~/.nvm/nvm.sh && npm run watch",  // Load nvm and then run npm
		"isBackground": true,
		"problemMatcher": ["$tsc-watch"],
		"group": {
		  "kind": "build",
		  "isDefault": true
		},
		"options": {
			"env": {
			"PATH": "~/.nvm/versions/node/v16.16.0/bin:${env:PATH}"
			}
		}
	  }
	]
  }
  