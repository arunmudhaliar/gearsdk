# This .gitignore file should be placed at the root of your Unity project directory

# =============== #
# Unity generated #
# =============== #
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain sensitive data.
[Mm]emoryCaptures/

# ====================== #
# Visual Studio / Rider  #
# ====================== #
[Ee]xported[Oo]bj/
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
.idea/
*.iws
*.iml
*.ipr
*.swp
*~
_ReSharper*/
*.resharper
*.DotSettings

# ============ #
# OS generated #
# ============ #
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# =============== #
# Builds & Assets #
# =============== #
# Uncomment if you don't wish to share your build settings.
#**/Builds/

# Asset store source zip files
*.zip

# Autogenerated Jetbrains Rider plugin
# Might be better to keep this ignored, since it should auto-generate when needed.
# However, unignoring and committing this could ensure consistent coding standards in a team.
#JetBrains.Rider.Unity.Editor.Plugin.Repacked/

# ================= #
# Misc files #
# ================= #
# These files are often included in Unity asset packages, but you likely don't want them in source control
*.pdf
*.PDF
*.docx
*.DOCX
*.xlsx
*.XLSX

# ================= #
# macOS Retina files #
# ================= #
# High resolution files can also get quite large and should not be needed in source control
*.tif
*.TIF
*.tiff
*.TIFF

# ============= #
# Node Modules #
# ============= #
# If using Node.js packages in your Unity project, you might want to ignore the heavy node modules folder
node_modules/

# ==================== #
# Visual Studio Code #
# ==================== #
# Uncomment if you wish to ignore VS Code settings (workspace specific)
#.vscode/

# ======================================== #
# Unity Package Manager (UPM) #
# ======================================== #
# Uncomment to ignore package lock files which may cause merge conflicts
# Also, these files can be regenerated by Unity
#Packages/packages-lock.json

# ======================== #
# Windows Image File Cache #
# ======================== #
# Windows generates these when browsing folders containing images, not useful for version control
Thumbs.db
ehthumbs.db

# ============== #
# Unity specific #
# ============== #
# Ignore the auto-generated YAML merge files
*.orig

# ============================= #
# Ignore specific Asset folders #
# ============================= #
# You might have folders in your Unity Assets directory that you don't want to include in version control.
# Typically, these are large binary files or personal test scenes/scripts.
# Examples (uncomment or modify as needed):
#Assets/Artwork/
#Assets/Tests/
