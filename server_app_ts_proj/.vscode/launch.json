{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug - Launch server-app",
      "program": "${workspaceFolder}/dist/app.js",
      "env": {
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/../serverplugin",
        "NODE_ENV": "development"
      },
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "runtimeVersion": "16.16.0",
      "runtimeExecutable": "node",
      "preLaunchTask": "build-app:debug",
      "runtimeArgs": [
        "--trace-exit"
      ],
      "outputCapture": "std"
    }
  ]
}