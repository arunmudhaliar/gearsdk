{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "lua",
        "request": "launch",
        "name": "Launch Lua Program",
        "program": "${workspaceFolder}/src/main.lua",
        "cwd": "${workspaceFolder}",
        "stopOnEntry": false,
        "env": {
          "SERVER_ENV": "development"  // Set the SERVER_ENV variable
        }
      }
    ]
  }

